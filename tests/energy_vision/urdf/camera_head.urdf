<?xml version="1.0"?>
<robot name="camera_head">
  <link name="base_link"/>
  <link name="yaw_pivot"/>
  <link name="yaw_link"/>
  <link name="pitch_pivot"/>
  <link name="pitch_link"/>
  <link name="camera_link"/>
  <link name="launcher_blue/pitch_link/camera_optical_frame"/>

  <joint name="yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="yaw_pivot"/>
    <origin xyz="0 0 0.080"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796" effort="20" velocity="6"/>
  </joint>

  <joint name="yaw_pivot_to_link" type="fixed">
    <parent link="yaw_pivot"/>
    <child link="yaw_link"/>
    <origin xyz="0 0 -0.040"/>
  </joint>

  <joint name="pitch_joint" type="revolute">
    <parent link="yaw_link"/>
    <child link="pitch_pivot"/>
    <origin xyz="0 0 0.290"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.174533" upper="0.785398" effort="20" velocity="6"/>
  </joint>

  <joint name="pitch_pivot_to_link" type="fixed">
    <parent link="pitch_pivot"/>
    <child link="pitch_link"/>
    <origin xyz="0 0 -0.145"/>
  </joint>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.036 0.075" rpy="0 0 1.570796"/>
  </joint>

  <!-- Camera body: X forward, Y left, Z up. Optical: X right, Y down, Z forward. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="launcher_blue/pitch_link/camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
